{
  "version": 2,
  "builds": [
    {
      "src": "api/*.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "client/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/v1/(.*)",
      "dest": "/api/index.ts?__orig_path=/v1/$1"
    },
    {
      "src": "/v1beta/(.*)",
      "dest": "/api/index.ts?__orig_path=/v1beta/$1"
    },
    {
      "src": "/v1",
      "dest": "/api/index.ts?__orig_path=/v1"
    },
    {
      "src": "/v1beta",
      "dest": "/api/index.ts?__orig_path=/v1beta"
    },
    {
      "src": "/api/ping",
      "dest": "/api/ping.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts?__orig_path=/api/$1"
    },
    {
      "src": "/api",
      "dest": "/api/index.ts?__orig_path=/api"
    },
    {
      "src": "/mcp/(.*)",
      "dest": "/api/index.ts?__orig_path=/mcp/$1"
    },
    {
      "src": "/mcp",
      "dest": "/api/index.ts?__orig_path=/mcp"
    },
    {
      "src": "/livez",
      "dest": "/api/index.ts?__orig_path=/livez"
    },
    {
      "src": "/readyz",
      "dest": "/api/index.ts?__orig_path=/readyz"
    },
    {
      "src": "/((?!assets|favicon|logo).*)",
      "dest": "/index.html"
    }
  ]
}
