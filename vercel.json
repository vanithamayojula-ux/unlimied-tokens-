{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api/index?__orig_path=/v1/:path*"
    },
    {
      "source": "/v1beta/:path*",
      "destination": "/api/index?__orig_path=/v1beta/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__orig_path=/api/:path*"
    },
    {
      "source": "/mcp/:path*",
      "destination": "/api/index?__orig_path=/mcp/:path*"
    },
    {
      "source": "/((?!assets|favicon|logo).*)",
      "destination": "/index.html"
    }
  ]
}
