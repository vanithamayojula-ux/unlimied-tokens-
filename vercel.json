{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/v1beta/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/mcp/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/((?!assets|favicon|logo).*)",
      "destination": "/index.html"
    }
  ]
}
