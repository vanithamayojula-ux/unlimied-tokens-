{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api/index?__orig_path=/v1/:path*"
    },
    {
      "source": "/v1beta/:path*",
      "destination": "/api/index?__orig_path=/v1beta/:path*"
    },
    {
      "source": "/api/:sub(auth|keys|client-profiles|conversations|logs|models|profiles|fallback|embeddings|media|analytics|health|free-tier|settings|premium|backups|cache|compression|update|ping|tags|version|show|chat|generate|embed):path*",
      "destination": "/api/index?__orig_path=/api/:sub:path*"
    },
    {
      "source": "/mcp/:path*",
      "destination": "/api/index?__orig_path=/mcp/:path*"
    },
    {
      "source": "/livez",
      "destination": "/api/index?__orig_path=/livez"
    },
    {
      "source": "/readyz",
      "destination": "/api/index?__orig_path=/readyz"
    },
    {
      "source": "/((?!assets|favicon|logo).*)",
      "destination": "/index.html"
    }
  ]
}
